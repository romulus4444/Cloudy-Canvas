<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>dotnet-Cloudy_Canvas-C054BD3A-F4E3-4221-81C0-9AE116BDD30F</UserSecretsId>
    <RootNamespace>Cloudy_Canvas</RootNamespace>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Rules switched off, and why. They live here rather than in .editorconfig because the Nix build only sees this project folder:
         CA1848 and CA1873: source-generated LoggerMessage delegates; the bot logs a handful of lines per command, so the boilerplate
         isn't worth the performance.
         CA1707: the root namespace is Cloudy_Canvas (the project name has a hyphen); renaming it would touch every file.
         CA1822: Discord.Net command methods must be instance methods even when they don't use instance state. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1707;CA1822</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <!-- CI (GitHub Actions sets CI=true) fails on warnings; local builds don't. Vulnerable-package advisories (NU190x) are excluded so a
         new advisory can't block unrelated pull requests; Dependabot and the vulnerable-package report of dotnet list package cover those. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
</Project>